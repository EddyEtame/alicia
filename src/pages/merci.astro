---
import Base from "../layouts/Base.astro";
---

<Base title="Merci · Alicia" description="Votre message est parti. Alicia vous répond en général dans la journée." image="/og/contact.png">
  <section class="first contact">
    <span class="eyebrow rv">message envoyé</span>
    <h1 class="page-title words">
      <span class="w">Merci,</span> <span class="w">c'est</span> <span class="w">bien</span> <span class="w">parti.</span>
    </h1>
    <p class="lede rv">Je vous réponds en général dans la journée, à l'adresse que vous avez laissée.</p>
    <div class="links rv">
      <a href="/" class="more">retour à l'accueil</a>
      <a href="/projets/">voir les projets</a>
    </div>
  </section>
</Base>
